 {
  "source": "embedded-web",
  "en": "It can add and edit, but can’t delete — and every change is snapshotted, so Version History can roll it back.",
  "zh": "它可以添加和编辑，但无法删除 —— 而且每次修改都会生成快照，版本历史可以回滚。",
  "file": "app.js",
  "offset": "char@2045808"
 },
 {
  "source": "embedded-web",
  "en": "Live.",
  "zh": "实时。",
  "file": "app.js",
  "offset": "char@2045943"
 },
 {
  "source": "embedded-web",
  "en": "If the project is open in Beat, Claude’s edits appear on your canvas in a second or two.",
  "zh": "如果项目正在 Beat 中打开，Claude 的修改会在一两秒内出现在你的画布上。",
  "file": "app.js",
  "offset": "char@2045952"
 },
 {
  "source": "embedded-web",
  "en": "One-time setup,",
  "zh": "一次性设置，",
  "file": "app.js",
