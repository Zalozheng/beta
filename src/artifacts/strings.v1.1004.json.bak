  "en": "Claude Code",
  "zh": "Claude Code",
  "file": "app.js",
  "offset": "char@2046459"
 },
 {
  "source": "embedded-web",
  "en": "— not the website, because only an app on your computer can reach tools on it. Beat sets up both.",
  "zh": "—— 而不是网站，因为只有你电脑上的应用才能访问它的工具。Beat 会同时配置两者。",
  "file": "app.js",
  "offset": "char@2046474"
 },
 {
  "source": "embedded-web",
  "en": "Download Claude Desktop from",
  "zh": "从以下地址下载 Claude 桌面版",
  "file": "app.js",
  "offset": "char@2046609"
 },
