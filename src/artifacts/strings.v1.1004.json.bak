 },
 {
  "source": "embedded-web",
  "en": "You’ll drive Beat from a Claude app on this Mac —",
  "zh": "你将通过这台 Mac 上的 Claude 应用来驱动 Beat ——",
  "file": "app.js",
  "offset": "char@2046381"
 },
 {
  "source": "embedded-web",
  "en": "Claude Desktop",
  "zh": "Claude 桌面版",
