 },
 {
  "source": "embedded-web",
  "en": "The floor",
  "zh": "地面",
  "file": "app.js",
  "offset": "key:title@103639"
 },
 {
  "source": "embedded-web",
  "en": "The mirror",
  "zh": "镜子",
  "file": "app.js",
  "offset": "key:title@105210"
 },
 {
  "source": "embedded-web",
  "en": "Back to the bed",
  "zh": "回到床",
  "file": "app.js",
  "offset": "key:title@105840"
 },
 {
  "source": "embedded-web",
  "en": "The feet",
  "zh": "双脚",
  "file": "app.js",
  "offset": "key:title@106459"
 },
 {
  "source": "embedded-web",
  "en": "Filter, sort, resize",
  "zh": "筛选、排序、调整大小",
  "file": "app.js",
  "offset": "key:title@1406925"
 },
 {
  "source": "embedded-web",
  "en": "Drag anything onto the canvas",
  "zh": "把任何东西拖到画布上",
  "file": "app.js",
  "offset": "key:title@1407150"
 },
 {
  "source": "embedded-web",
  "en": "Everyone and everything in the story",
  "zh": "故事里的每个人和每样东西",
  "file": "app.js",
  "offset": "key:title@1414480"
 },
 {
